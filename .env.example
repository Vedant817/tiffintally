# TiffinTally Environment Configuration
# Copy this file to .env and fill in your keys.
# NEVER commit your .env file to git!

# Google AI Studio (for Gemma baseline and teacher model)
# Get key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=""
GEMMA_MODEL="gemma-2-9b-it"

# Tinker (for fine-tuning and served LoRA inference)
# Docs: https://thinkingmachines.ai/tinker/
TINKER_API_KEY=""
TINKER_MODEL_ID=""

# Prior Labs TabPFN (for intelligent plate forecasting)
# Get key from: https://platform.priorlabs.ai
TABPFN_API_KEY=""

# ElevenLabs (for morning Hinglish voice brief)
# Get key from: https://elevenlabs.io
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""

# Optional: Sentry Agent Tracing
SENTRY_DSN=""

# Application Settings
TIFFINTALLY_DEMO_MODE="false"
TIFFINTALLY_CUTOFF_HOUR="23"
TIFFINTALLY_CUTOFF_MINUTE="00"
TIFFINTALLY_PORT="8000"
TIFFINTALLY_HOST="0.0.0.0"
