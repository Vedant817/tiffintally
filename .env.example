# TiffinTally environment configuration
# Copy this file to .env and fill in your keys.
# NEVER commit your .env file to git!
#
# Every key here is optional. With none of them set the app runs the offline
# regex rules and the UI says so. Nothing below has been measured: no hosted
# Gemma run exists in this repository, so RESULTS.md records it as NOT RUN.

# --- Extraction backend ------------------------------------------------------
# Which extractor answers a paste. Leave unset to auto-select: modal if its
# endpoint is configured, then gemini if GOOGLE_API_KEY is set, then openai if
# an OpenAI-compatible endpoint is set, else the offline rules.
# Set it explicitly to force a choice:
#   off     - offline rules only; nothing leaves the machine
#   gemini  - hosted Gemma through Google AI Studio (default id gemma-4-26b-a4b-it)
#   openai  - any OpenAI-compatible endpoint, e.g. local Ollama
#   modal   - the fine-tuned Qwen adapter on Modal (not published, not measured)
EXTRACTOR_BACKEND=""

# --- Google AI Studio (hosted Gemma) ----------------------------------------
# Get a key from: https://aistudio.google.com/app/apikey
# Setting this key on a public URL sends masked visitor text to Google and
# spends your quota. Leave it unset for a rules-only public demo.
GOOGLE_API_KEY=""
# Only read when the gemini backend is selected.
GEMMA_MODEL="gemma-4-26b-a4b-it"

# --- OpenAI-compatible endpoint (Ollama, vLLM, Groq) ------------------------
# Wired in, never measured.
OPENAI_BASE_URL=""
OPENAI_API_KEY=""
OPENAI_MODEL_NAME="qwen2.5:3b"

# --- Modal (fine-tuned Qwen2.5-3B adapter) ----------------------------------
# The Qwen base is a research licence, so it is non-commercial. The adapter is
# not published in this repository and has not been measured. No GPU calls are
# authorised: see HUMAN_TODO.md.
MODAL_EXTRACTOR_URL=""
MODAL_EXTRACTOR_TOKEN=""

# --- ElevenLabs (morning voice brief) ---------------------------------------
# Optional. Without a key the brief degrades to text instead of audio.
# Get a key from: https://elevenlabs.io
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""

# --- Optional: Sentry Agent Tracing -----------------------------------------
SENTRY_DSN=""

# --- Application settings ----------------------------------------------------
# Demo mode keeps every sheet in session memory and writes nothing to disk.
TIFFINTALLY_DEMO_MODE="false"
# SQLite persistence is a separate, explicit opt-in, and demo mode overrides it.
# Stored chat lines and names are masked; see the README privacy section.
TIFFINTALLY_PERSIST="0"
TIFFINTALLY_CUTOFF_HOUR="23"
TIFFINTALLY_CUTOFF_MINUTE="00"
TIFFINTALLY_PORT="8000"
TIFFINTALLY_HOST="0.0.0.0"
# Telemetry is a local audit log of what actually answered, never uploaded.
TIFFINTALLY_TELEMETRY="1"